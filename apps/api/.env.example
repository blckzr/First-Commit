# ---- Server ----
NODE_ENV=development
PORT=4000
# The frontend's origin. Cookies need this to be explicit — a wildcard is not
# allowed with credentials.
APP_ORIGIN=http://localhost:5173

# ---- Database ----
# The API uses the POOLER (port 6543). Render restarts often, and pooling
# avoids exhausting Supabase's connection limit. The worker is the opposite
# case and uses a direct connection on 5432.
DATABASE_URL=postgresql://postgres:<password>@<host>:6543/postgres

# ---- Sessions ----
# Signs the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---- The local AI worker ----
# Shared secret so the worker can POST /internal/events when a result is ready.
# Leave unset and results still reach the browser through the periodic sweep.
WORKER_SECRET=

# ---- Mail (Brevo) ----
# Leave BREVO_API_KEY unset in development: links are logged to the console
# instead of sent, which is enough to build and test all of section 6.3.
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=First Commit

# ---- GitHub App (the capstone) ----
# Leave ALL of these unset in development: the API uses a client that invents a
# consistent account and repository, so the whole connect flow works without an
# App existing. Registering one is what you do before tracking a REAL repository.
#
# Set all five or none — a half-configured App is refused at boot.
#
# Register at: https://github.com/settings/apps/new  (or your organisation's
# settings). What to choose:
#   Callback URL ............ http://localhost:4000/github/callback
#   Request user authorization (OAuth) during installation ... ON
#     (this is what tells the platform WHICH GitHub account installed it)
#   Webhook URL ............. leave inactive until the API is deployed; the
#                             worker's periodic commit check covers it meanwhile
#   Permissions:
#     Repository > Metadata ..... Read-only  (mandatory)
#     Repository > Contents ..... Read-only  (file_exists checks, commits)
#     Repository > Actions ...... Read-only  (workflow_test checks)
#   Subscribe to events: Push
#   Where can this be installed: Any account
#
# GITHUB_APP_SLUG is the name in the install URL, not the numeric id:
#   github.com/apps/THIS-PART/installations/new
#
# GITHUB_PRIVATE_KEY is the .pem you download once. Keep the newlines — paste it
# quoted, or convert to a single line with \n escapes. It is never logged and
# never leaves this file.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PRIVATE_KEY=
# Only needed once webhooks are switched on, after the API has a public address.
GITHUB_WEBHOOK_SECRET=
