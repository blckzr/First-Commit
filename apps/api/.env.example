# ---- Server ----
NODE_ENV=development
PORT=4000
# The frontend's origin. Cookies need this to be explicit — a wildcard is not
# allowed with credentials.
APP_ORIGIN=http://localhost:5173

# ---- Database ----
# The API uses the POOLER (port 6543). Render restarts often, and pooling
# avoids exhausting Supabase's connection limit. The worker is the opposite
# case and uses a direct connection on 5432.
DATABASE_URL=postgresql://postgres:<password>@<host>:6543/postgres

# ---- Sessions ----
# Signs the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---- The local AI worker ----
# Shared secret so the worker can POST /internal/events when a result is ready.
# Leave unset and results still reach the browser through the periodic sweep.
WORKER_SECRET=

# ---- Mail (Brevo) ----
# Leave BREVO_API_KEY unset in development: links are logged to the console
# instead of sent, which is enough to build and test all of section 6.3.
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=First Commit
