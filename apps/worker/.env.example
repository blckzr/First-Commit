# ---- Ollama ----
OLLAMA_URL=http://127.0.0.1:11434
# Use qwen3.5:4b while developing; switch to qwen3.5:9b after comparing them.
AI_MODEL=qwen3.5:4b
# Set by `npm run check`: think_off_schema | think_on_schema | prompt_only
AI_JSON_MODE=think_off_schema
# Context window per request. 8192 covers exercises; milestone reviews use AI_CONTEXT_LARGE.
AI_CONTEXT=8192
AI_CONTEXT_LARGE=16384
AI_TIMEOUT_MS=120000

# ---- Database ----
# The worker uses the DIRECT connection (port 5432), not the pooler the API uses:
# it holds one long-lived connection and claims jobs inside a transaction.
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres
WORKER_POLL_MS=3000

# ---- Telling the API a result is ready (optional) ----
# The worker POSTs here after writing a result so the API can push it over SSE.
# Leave both unset and results still land in the database; the API's periodic
# sweep finds them, just a little later.
API_URL=
WORKER_SECRET=
