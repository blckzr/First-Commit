# ---- Ollama ----
OLLAMA_URL=http://127.0.0.1:11434
# Use qwen3.5:4b while developing; switch to qwen3.5:9b after comparing them.
AI_MODEL=qwen3.5:4b
# Set by `npm run check`: think_off_schema | think_on_schema | prompt_only
AI_JSON_MODE=think_off_schema
# Context window per request. 8192 covers exercises; milestone reviews use AI_CONTEXT_LARGE.
AI_CONTEXT=8192
AI_CONTEXT_LARGE=16384
AI_TIMEOUT_MS=120000

# ---- Database ----
# Use the pooler host on port 5432 (session mode) — the same string the API
# uses, with 6543 changed to 5432.
#
# Why session mode: the worker is one long-lived process holding one
# connection. Session mode is what Supabase documents for a persistent server;
# transaction mode (6543) is for many short-lived clients, which is the API on
# Render. Sharing the API's transaction pool with a process that never
# disconnects is the wrong shape, and it competes for the pool the API needs.
#
# Transaction mode does *work* — Supavisor, unlike PgBouncer, keeps prepared
# statements across a transaction-mode connection, and `for update skip locked`
# inside a transaction is unaffected. So 6543 is a working fallback, not a bug.
#
# Do NOT use `db.<project-ref>.supabase.co`. That host publishes an AAAA record
# and no A record, so an IPv4-only machine fails with ENOTFOUND. The pooler
# host resolves on both.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres
WORKER_POLL_MS=3000

# ---- Telling the API a result is ready (optional) ----
# The worker POSTs here after writing a result so the API can push it over SSE.
# Leave both unset and results still land in the database; the API's periodic
# sweep finds them, just a little later.
API_URL=
WORKER_SECRET=

# ---- The code sandbox (design.md §5.11) ----
# Which sandbox runs a learner's code. `none` refuses honestly — a submission
# fails with an explanation rather than queueing forever. Switch to `judge0`
# only after `npm run judge0:check` passes; setup is docker/judge0/README.md.
CODE_RUNNER=none

# Judge0's published port is 2358. Use 127.0.0.1, not localhost: on Windows
# localhost can resolve to ::1 first and Judge0 publishes on IPv4.
JUDGE0_URL=http://127.0.0.1:2358

# Only if you set AUTHN_TOKEN in judge0.conf. Leave empty for a local install
# that is not reachable from outside this machine.
JUDGE0_TOKEN=

# Per-submission limits. Tight on purpose: this machine also holds a model in
# VRAM, and the worker runs one job at a time, so a runaway loop must not be
# able to hold the slot or pressure the host.
JUDGE0_CPU_SECONDS=5
JUDGE0_MEMORY_KB=128000
