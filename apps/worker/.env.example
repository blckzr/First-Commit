# ---- Ollama ----
OLLAMA_URL=http://127.0.0.1:11434
# Use qwen3.5:4b while developing; switch to qwen3.5:9b after comparing them.
AI_MODEL=qwen3.5:4b
# Set by `npm run check`: think_off_schema | think_on_schema | prompt_only
AI_JSON_MODE=think_off_schema
# Context window per request. 8192 covers exercises; milestone reviews use AI_CONTEXT_LARGE.
AI_CONTEXT=8192
AI_CONTEXT_LARGE=16384
AI_TIMEOUT_MS=120000

# ---- Supabase (worker only; never put the service role key in the React app) ----
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
WORKER_POLL_MS=3000
