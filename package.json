{
  "name": "first-commit",
  "version": "0.0.0",
  "private": true,
  "description": "First Commit: an AI-assisted online learning platform for aspiring programmers",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "npm run check -w @first-commit/worker",
    "try:feedback": "npm run try:feedback -w @first-commit/worker",
    "try:roadmap": "npm run try:roadmap -w @first-commit/worker",
    "worker": "npm run worker -w @first-commit/worker",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev": "npm run dev -w @first-commit/web",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test:run --workspaces --if-present",
    "e2e": "npm run e2e -w @first-commit/web",
    "dev:api": "npm run dev -w @first-commit/api",
    "db:migrate": "node --env-file=apps/api/.env scripts/db.mjs migrate",
    "db:verify": "node --env-file=apps/api/.env scripts/db.mjs verify",
    "db:seed": "node --env-file=apps/api/.env scripts/seed.mjs"
  }
}
